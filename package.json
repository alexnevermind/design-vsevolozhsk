{
  "name": "vsevolozhsk-site-configurator",
  "version": "2.0.0",
  "private": true,
  "description": "Участок во Всеволожске — интерактивный 3D-конфигуратор участка с тремя постройками (Three.js); основа — конфигуратор дома VSEMDOM",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spec": "node scripts/build-spec.mjs",
    "site": "node scripts/build-site.mjs",
    "site:png": "node scripts/render-site-plan.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "serve": "python3 -m http.server 8769 --bind 127.0.0.1 --directory dist",
    "assets:blender": "bash scripts/blender/build-all.sh",
    "package:offline": "node scripts/package-offline.mjs",
    "browser:check": "node scripts/browser-check.mjs",
    "site:check": "node scripts/site-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "site:shots": "node scripts/site-screenshots.mjs",
    "export:glb": "node scripts/export-glb.mjs",
    "offline:check": "node scripts/offline-check.mjs",
    "check:all": "npm test && npm run spec -- --check && npm run site -- --check && npm run site:check && npm run browser:check && npm run package:offline && npm run offline:check && npm run checks:report",
    "checks:report": "node scripts/checks-report.mjs"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "playwright": "1.56.1",
    "three": "0.183.2"
  }
}
